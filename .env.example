# =====================================================================
# Cryptoville — variables de entorno para PRODUCCIÓN (VPS + Supabase en la nube)
# Copia este archivo como .env (en la raíz del proyecto) y llena cada valor.
# deploy/deploy.sh revisa que no falte ninguno de los obligatorios.
# Para desarrollo local NO lo llenes a mano: ejecuta `npm run setup` (usa .env.local.example).
# =====================================================================

# --- General ---------------------------------------------------------
NODE_ENV=production
# Puerto interno de la API dentro de Docker (Caddy le reenvía /api). No hace falta cambiarlo.
PORT=3000
# Cómo se entra a la app desde internet. Con sslip.io (recomendado, da HTTPS):
#   tu IP 140.238.10.25  ->  140-238-10-25.sslip.io
# O solo la IP (sin HTTPS):  140.238.10.25
# Cuando compres un dominio, pon aquí el dominio.
PUBLIC_HOST=140-238-10-25.sslip.io
# Solo si el VPS es COMPARTIDO y te dieron un único puerto (por ejemplo 6702):
# Cryptoville usará solo ese puerto, por HTTP, sin tocar los puertos 80/443 de otros servicios.
# En ese caso pon en PUBLIC_HOST la IP sola (144.22.43.169). Vacío = usar 80 y 443 con HTTPS.
PUERTO_PUBLICO=
# Orígenes extra que pueden llamar a la API (separados por coma). Vacío = solo la misma URL.
CORS_ORIGINS=
# Nivel de logs: info en producción (debug para investigar problemas).
LOG_LEVEL=info

# --- Supabase (supabase.com → tu proyecto → Project Settings) --------
# Data API → Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# (Opcional) URL de Supabase que usa el navegador si es distinta de la anterior. Normalmente vacía.
SUPABASE_PUBLIC_URL=
# API Keys → anon / publishable (es pública: la usa el navegador, protegida por RLS)
SUPABASE_ANON_KEY=
# API Keys → service_role / secret. ¡SECRETA! Solo la usa la API. Nunca la compartas.
SUPABASE_SERVICE_ROLE_KEY=
# Database → Connect → "Transaction pooler" (puerto 6543). La usa la API en ejecución.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres
# Database → Connect → "Session pooler" (puerto 5432). La usan las migraciones y los respaldos.
DIRECT_URL=postgresql://postgres.TU-PROYECTO:TU-CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Inicio de sesión con wallet --------------------------------------
# Secreto para derivar la contraseña interna de cada wallet en Supabase Auth.
# Genera uno con:  openssl rand -hex 32   (y NO lo cambies después: las cuentas dejarían de entrar)
AUTH_PASSWORD_SECRET=
# Dominio de los correos internos de las cuentas (no se envía ningún correo).
AUTH_EMAIL_DOMAIN=wallet.cryptoville.test

# --- Stellar (todo se copia desde Stellar Lab, ver docs/guia-stellar-lab.md) ---
STELLAR_NETWORK=testnet
# Dirección del contrato de escrow desplegado (C…). Vacío = la app avisa que falta desplegarlo.
ESCROW_CONTRACT_ID=
# Dirección del contrato del token de pago (C…), la misma que se usó en el constructor del escrow.
# En testnet es el contrato "USDC de prueba" que despliegas en el Lab.
PAYMENT_TOKEN_ID=
# Nombre del token que se muestra en la app.
PAYMENT_ASSET=USDC de prueba
# Wallet del árbitro (admin del contrato).
ARBITRO_DIRECCION=
# Deben coincidir con lo que pusiste en el constructor del contrato.
COMISION_BPS=300
PLAZO_REVISION_SEG=259200

# --- Cryptoville v2: la red y los contratos nuevos ---------------------
# RPC de Soroban para leer la red (armar transacciones y verificar pagos). Vacío = el público de la red elegida.
STELLAR_RPC_URL=
# Verificar cada paso en la red antes de registrarlo: si | no (por defecto: si, menos en las pruebas automáticas).
STELLAR_VERIFICAR=
# Contrato de escrow v2 (fases, pago directo). Vacío = todo sigue con el contrato v1 y no hay fases.
ESCROW_V2_CONTRACT_ID=
# Cuenta que recibe las comisiones y el pago de los locales extra (la misma del constructor del contrato).
TESORERIA_DIRECCION=
# Llave de mantenimiento (S…): la ÚNICA llave en el servidor. Solo ejecuta vencimientos del contrato v2
# y solo debe tener XLM para las comisiones de red. Vacía = los vencimientos no se ejecutan solos.
LLAVE_MANTENIMIENTO=
# URL pública de la app (para volver del KYC y para los enlaces de los correos). Vacía = se arma con PUBLIC_HOST.
PUBLIC_URL=
# pruebas | produccion: si los servicios externos usan sandbox o llaves reales (en mainnet: produccion).
ENTORNO_SERVICIOS=pruebas

# --- Servicios externos: cada uno se enciende solo si están TODAS sus variables ---
# Entrar con correo (Pollar, https://dashboard.pollar.xyz). La llave es pública (la usa el navegador).
POLLAR_API_KEY=
# QR para firmar con la wallet del celular (WalletConnect / Reown, https://cloud.reown.com). Público.
WALLETCONNECT_PROJECT_ID=
# KYC (Didit, https://business.didit.me): llave, flujo y secreto del webhook. Webhook: https://TU-DOMINIO/api/kyc/webhook
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Secreto para la huella del documento (detecta cuentas duplicadas sin guardar el número). openssl rand -hex 32. NO lo cambies después.
KYC_HMAC_SECRET=
# Videos de pruebas y portafolio (Mux, https://dashboard.mux.com). Webhook: https://TU-DOMINIO/api/videos/webhook
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Llave para reproducir videos privados (Settings → Signing keys). La privada va en base64, tal como la entrega Mux.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
# Correos de aviso (Resend, https://resend.com). Necesita un dominio propio verificado.
RESEND_API_KEY=
CORREO_REMITENTE=
# Notificaciones del navegador (Web Push). Genera las llaves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de notificaciones (mailto:equipo@tu-dominio).
VAPID_CONTACTO=

# --- Rampa simulada (SOLO testnet) ---------------------------------------
# «Pagar con el QR de tu banco» y «Pasar a mi banco» de mentira (docs/simulaciones.md).
# En mainnet la API no arranca si RAMPA_SIMULADA=si: ahí la rampa es real (Pollar).
RAMPA_SIMULADA=
# Llave S… del emisor del USDC de prueba (en el servidor no está .seed-keys.json).
RAMPA_SIMULADA_LLAVE=

# --- Respaldos ----------------------------------------------------------
# Días de respaldos diarios que se guardan en deploy/backups.
BACKUP_KEEP_DAYS=7
