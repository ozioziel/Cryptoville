# =====================================================================
# Cryptoville — variables para DESARROLLO LOCAL (Supabase local con Docker)
# `npm run setup` crea el .env a partir de este archivo y llena las llaves
# de Supabase local automáticamente. Mismo significado que en .env.example.
# =====================================================================
NODE_ENV=development
PORT=3000
PUBLIC_HOST=localhost
PUERTO_PUBLICO=
CORS_ORIGINS=
LOG_LEVEL=debug

# Supabase local (npx supabase start). Las llaves las pone `npm run setup`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLIC_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# `npm run setup` genera uno al azar.
AUTH_PASSWORD_SECRET=
AUTH_EMAIL_DOMAIN=wallet.cryptoville.test

# Stellar testnet: llena estos cuando despliegues en Stellar Lab (docs/guia-stellar-lab.md).
STELLAR_NETWORK=testnet
ESCROW_CONTRACT_ID=
PAYMENT_TOKEN_ID=
PAYMENT_ASSET=USDC de prueba
ARBITRO_DIRECCION=
COMISION_BPS=300
PLAZO_REVISION_SEG=259200

# --- Cryptoville v2: la red y los contratos nuevos ---------------------
# RPC de Soroban para leer la red (armar transacciones y verificar pagos). Vacío = el público de la red elegida.
STELLAR_RPC_URL=
# Verificar cada paso en la red antes de registrarlo: si | no (por defecto: si, menos en las pruebas automáticas).
STELLAR_VERIFICAR=
# Contrato de escrow v2 (fases, pago directo). Vacío = todo sigue con el contrato v1 y no hay fases.
ESCROW_V2_CONTRACT_ID=
# Cuenta que recibe las comisiones y el pago de los locales extra (la misma del constructor del contrato).
TESORERIA_DIRECCION=
# Llave de mantenimiento (S…): la ÚNICA llave en el servidor. Solo ejecuta vencimientos del contrato v2
# y solo debe tener XLM para las comisiones de red. Vacía = los vencimientos no se ejecutan solos.
LLAVE_MANTENIMIENTO=
# URL pública de la app (para volver del KYC y para los enlaces de los correos). Vacía = se arma con PUBLIC_HOST.
PUBLIC_URL=
# pruebas | produccion: si los servicios externos usan sandbox o llaves reales (en mainnet: produccion).
ENTORNO_SERVICIOS=pruebas

# --- Servicios externos: cada uno se enciende solo si están TODAS sus variables ---
# Entrar con correo (Pollar, https://dashboard.pollar.xyz). La llave es pública (la usa el navegador).
POLLAR_API_KEY=
# «Entrar con Google» (si): apagado hasta probarlo con Pollar (docs/simulaciones.md).
POLLAR_GOOGLE=
# QR para firmar con la wallet del celular (WalletConnect / Reown, https://cloud.reown.com). Público.
WALLETCONNECT_PROJECT_ID=
# KYC (Didit, https://business.didit.me): llave, flujo y secreto del webhook. Webhook: https://TU-DOMINIO/api/kyc/webhook
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Secreto para la huella del documento (detecta cuentas duplicadas sin guardar el número). openssl rand -hex 32. NO lo cambies después.
KYC_HMAC_SECRET=
# Videos de pruebas y portafolio (Mux, https://dashboard.mux.com). Webhook: https://TU-DOMINIO/api/videos/webhook
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Llave para reproducir videos privados (Settings → Signing keys). La privada va en base64, tal como la entrega Mux.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
# Correos de aviso (Resend, https://resend.com). Necesita un dominio propio verificado.
RESEND_API_KEY=
CORREO_REMITENTE=
# Notificaciones del navegador (Web Push). Genera las llaves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de notificaciones (mailto:equipo@tu-dominio).
VAPID_CONTACTO=

# Rampa SIMULADA (solo testnet): «Pagar con el QR de tu banco» y «Pasar a mi banco» de mentira,
# para probar el flujo de quien no tiene USDC. Emite USDC de prueba. Ver docs/simulaciones.md.
RAMPA_SIMULADA=si
# Llave S… del emisor del USDC de prueba. Vacía = la de .seed-keys.json (en tu PC).
RAMPA_SIMULADA_LLAVE=

BACKUP_KEEP_DAYS=7
