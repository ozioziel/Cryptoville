{
  "name": "@cryptoville/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Cryptoville (NestJS + Prisma + Supabase)",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "prisma generate && jest --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@cryptoville/shared": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "@supabase/supabase-js": "^2.117.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.16.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.10.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
