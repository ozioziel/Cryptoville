# =====================================================================
# Cryptoville — variables para MAINNET (dinero real)
# Plantilla para el lanzamiento. Sigue la checklist de docs/mainnet.md.
#
# - Mainnet usa su PROPIO Supabase, su propio .env y sus propios contratos: no mezcles nada con testnet.
# - Antes de desplegar, revisa con:  npm run mainnet:revisar
# - Si algo de prueba queda configurado, la API NO arranca y dice qué falta.
# =====================================================================

NODE_ENV=production
PORT=3000
# Dominio propio (con HTTPS). En mainnet no sirve una IP sola.
PUBLIC_HOST=
PUBLIC_URL=
PUERTO_PUBLICO=
CORS_ORIGINS=
LOG_LEVEL=info

# --- Supabase de MAINNET (un proyecto nuevo, no el de testnet) ---------
SUPABASE_URL=
SUPABASE_PUBLIC_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# --- Inicio de sesión ---------------------------------------------------
# Uno nuevo (openssl rand -hex 32) y NO lo cambies nunca.
AUTH_PASSWORD_SECRET=
AUTH_EMAIL_DOMAIN=wallet.cryptoville.app

# --- Stellar MAINNET ------------------------------------------------------
STELLAR_NETWORK=mainnet
# Un RPC de mainnet (de un proveedor; el público de SDF es solo para testnet).
STELLAR_RPC_URL=
STELLAR_VERIFICAR=si
# Contrato v2 desplegado en mainnet (y el v1 solo si tenía pedidos).
ESCROW_V2_CONTRACT_ID=
ESCROW_CONTRACT_ID=
# Contrato SAC del USDC real (Circle). Verifica la dirección en la documentación oficial de Circle y de Stellar.
PAYMENT_TOKEN_ID=
PAYMENT_ASSET=USDC
# Cuentas en MULTIFIRMA (ver docs/mainnet.md): árbitro y tesorería, distintas entre sí.
ARBITRO_DIRECCION=
TESORERIA_DIRECCION=
# Deben coincidir con el contrato y con packages/shared/src/reglas.ts.
COMISION_BPS=300
PLAZO_REVISION_SEG=259200
# Cuenta de mantenimiento: solo XLM para comisiones, nunca USDC.
LLAVE_MANTENIMIENTO=

# --- Servicios externos con llaves REALES (no sandbox) ------------------
ENTORNO_SERVICIOS=produccion
POLLAR_API_KEY=
WALLETCONNECT_PROJECT_ID=
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
KYC_HMAC_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
RESEND_API_KEY=
CORREO_REMITENTE=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=

BACKUP_KEEP_DAYS=30
